root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
# Use file-scoped namespaces throughout.
csharp_style_namespace_declarations = file_scoped:warning

# CA1711: the `RequestQueue*` types deliberately mirror the Apify API resource name and the reference
# client. Renaming them away from the "Queue" suffix would break cross-client naming consistency, which
# the client requirements mandate. The rule stays on for every other suffix.
dotnet_code_quality.CA1711.allowed_suffixes = Queue

[*.{csproj,props,targets}]
indent_size = 2

[*.{yml,yaml,json,md}]
indent_size = 2
